# Sakshya — Environment Configuration
# Copy this file to .env and fill in values before running.

# Database (SQLite default for local dev; swap to postgres:// for production)
DATABASE_URL=sqlite:///./data/sakshya.db

# JWT signing secret — CHANGE THIS; must be at least 32 chars
SECRET_KEY=change-me-to-a-strong-secret-of-32-chars-min

# Set to true to enable /demo/users endpoint and demo control panel
DEMO_MODE=true

# Base URL used for QR code generation in release letters
# In dev: http://localhost:5173
# On LAN (phone QR test): http://<your-ip>:5173
PUBLIC_BASE_URL=http://localhost:5173

# CORS origins (comma-separated; * = allow all — fine for demo)
CORS_ORIGINS=*

